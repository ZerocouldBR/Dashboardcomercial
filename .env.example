# Dashboard Comercial - Variáveis de Ambiente

# API URL
VITE_API_URL=http://localhost:3001/api

# Autenticação
VITE_AUTH_TOKEN=seu_token_aqui

# Ambiente
VITE_ENV=development

# Refresh automático (em segundos)
VITE_AUTO_REFRESH_INTERVAL=300

# Cache (em segundos)
VITE_CACHE_TTL=300

# OpenAI API Key (para Localizador de Restaurantes)
# Obtenha sua chave em: https://platform.openai.com/api-keys
# Necessário para funcionalidades de análise inteligente
VITE_OPENAI_API_KEY=sk-your-api-key-here
